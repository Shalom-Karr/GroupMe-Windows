{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GroupMe",
  "version": "0.14.0",
  "identifier": "dev.shalomkarr.groupme",
  "build": {
    "frontendDist": "./frontend"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src 'self' ipc: http://ipc.localhost https://api.groupme.com; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/media/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Shalom-Karr/groupme-windows/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFMTQ1NUE5M0M2RkYxNUUKUldSZThXODhxVlVVM2pBTitRdk1QVDMxcTcrWWI0TTlvZEZJQk1Dc21jOFUvRjFlZ2x6V2pBWTQK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["msi", "nsis", "deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Network",
    "shortDescription": "GroupMe desktop app with local offline archive",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "languages": ["English"]
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"]
      }
    }
  }
}
